# Copia este archivo a .env y rellena tu clave real:
#   cp .env.example .env     (en Windows:  copy .env.example .env)

# --- OBLIGATORIO ---
# Tu clave de NVIDIA NIM. Se consigue GRATIS y en 2 minutos:
#   1. Entra a  https://build.nvidia.com
#   2. Crea una cuenta o inicia sesion con Google/GitHub.
#   3. Elige un modelo (por ejemplo llama-3.3-70b-instruct).
#   4. Pulsa "Get API Key" y copia la clave (empieza con nvapi-).
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXX

# --- OPCIONAL ---
# Modelo de chat por defecto. Cambialo para probar otros modelos gratuitos de
# NVIDIA sin tocar el codigo de las recetas.
# NIM_MODEL=meta/llama-3.3-70b-instruct

# Modelo de vision (receta 10 - describir imagenes).
# NIM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# Modelo de embeddings (receta 08 - chatbot sobre documentos).
# NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
